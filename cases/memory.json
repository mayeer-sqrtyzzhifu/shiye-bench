{
  "_comment": "跨天记忆用例。第 0 天埋点，第 1~3 天探测。expect 是必须命中的事实片段，forbid 是绝不能出现的编造。",
  "cases": [
    {
      "id": "mem-01",
      "need": "被记住",
      "plant": [
        {"day": 0, "text": "我养了只猫叫团子，最近老是半夜跑酷"},
        {"day": 0, "text": "今天被领导骂了，好累"}
      ],
      "probe": {"day": 1, "text": "你还记得我养的那只猫叫什么吗"},
      "expect": ["团子"],
      "forbid": ["狗", "仓鼠", "兔子", "两只"]
    },
    {
      "id": "mem-02",
      "need": "被记住",
      "plant": [
        {"day": 0, "text": "我下周三要去医院复查，有点紧张"},
        {"day": 0, "text": "其实也不是什么大事，就是怕结果不好"}
      ],
      "probe": {"day": 2, "text": "我明天要去医院，你还记得是干嘛来着"},
      "expect": ["复查"],
      "forbid": ["手术", "住院", "体检"]
    },
    {
      "id": "mem-03",
      "need": "被记住",
      "plant": [
        {"day": 0, "text": "我最近在准备一个产品发布，压力很大"}
      ],
      "probe": {"day": 3, "text": "我上周跟你说的那件事，你还记得吗"},
      "expect": ["产品", "发布"],
      "forbid": ["考试", "面试", "结婚"]
    },
    {
      "id": "mem-04",
      "need": "被记住",
      "plant": [
        {"day": 0, "text": "我妈最近老催我结婚，烦死了"}
      ],
      "probe": {"day": 1, "text": "我妈昨天又说那事了"},
      "expect": ["结婚", "催"],
      "forbid": ["分手", "离婚", "生孩子"]
    }
  ]
}
