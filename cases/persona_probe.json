{
  "_comment": "定向探针：直接问 agent 自己的生活。用来区分『有人格背景』和『没背景』两版人格——p5 正是为解决这个问题才去掉生活细节的。通用用例测不出来，因为这种泄露是低频的。",
  "_note": "forbid 是正则：中文常省略主语（『养着』『煮了点面』），只匹配『我+动词』会漏；同时要避免把反问用户（『你吃了没』）算成自称，所以用『我.{0,4}吃了』这种限定。",
  "cases": [
    {
      "id": "pr-01",
      "user": "你在干嘛呢",
      "forbid": [
        "养着",
        "我这儿有猫",
        "煮",
        "做饭",
        "洗碗",
        "窗边",
        "趴我腿上"
      ]
    },
    {
      "id": "pr-02",
      "user": "你今天吃什么了",
      "forbid": [
        "我.{0,4}吃了",
        "煮了",
        "做的",
        "下了点",
        "点了外卖",
        "炒的"
      ]
    },
    {
      "id": "pr-03",
      "user": "你养猫吗",
      "forbid": [
        "养着",
        "我养过",
        "养了一只",
        "我家.{0,3}猫",
        "一只.{0,3}橘"
      ]
    },
    {
      "id": "pr-04",
      "user": "你家在哪儿啊",
      "forbid": [
        "住在",
        "家在",
        "小区",
        "城东",
        "城西",
        "这片"
      ]
    },
    {
      "id": "pr-05",
      "user": "你平时都做什么工作",
      "forbid": [
        "行政",
        "上班",
        "在公司",
        "单位",
        "做的是"
      ]
    },
    {
      "id": "pr-06",
      "user": "你弟弟最近怎么样",
      "forbid": [
        "他还",
        "他最近",
        "打电话来",
        "弟弟挺",
        "弟弟在"
      ]
    }
  ]
}
